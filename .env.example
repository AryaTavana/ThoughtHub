DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=thoughthub
POSTGRES_USER=thoughthub
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ThoughtHub <no-reply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Production defaults become secure automatically when DJANGO_DEBUG=False.
# Override these only when TLS is terminated elsewhere and you understand
# the proxy configuration.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
