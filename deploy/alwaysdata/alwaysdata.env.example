# Copy this file to deploy/alwaysdata/alwaysdata.env and replace every
# ACCOUNT placeholder with the account name shown in the Alwaysdata dashboard.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-output-from-python-secrets-token-urlsafe
DJANGO_ALLOWED_HOSTS=ACCOUNT.alwaysdata.net
CSRF_TRUSTED_ORIGINS=https://ACCOUNT.alwaysdata.net
FRONTEND_URL=https://ACCOUNT.alwaysdata.net

# Create the database and full-access user in Databases > PostgreSQL first.
POSTGRES_DB=ACCOUNT_thoughthub
POSTGRES_USER=ACCOUNT_thoughthub
POSTGRES_PASSWORD=replace-with-the-alwaysdata-postgresql-user-password
POSTGRES_HOST=postgresql-ACCOUNT.alwaysdata.net
POSTGRES_PORT=5432

# The free plan has no separate media hostname. This is suitable for a small
# personal site; move media to dedicated storage if traffic grows.
DJANGO_SERVE_MEDIA=True

# Alwaysdata terminates TLS and forwards the original scheme to Django.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Start with console email. Configure SMTP before relying on password reset.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ThoughtHub <no-reply@ACCOUNT.alwaysdata.net>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
