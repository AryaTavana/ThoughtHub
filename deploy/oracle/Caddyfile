{$DOMAIN} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle_path /media/* {
        root * /srv/media
        header Cache-Control "public, max-age=86400"
        file_server
    }

    reverse_proxy web:8000
}
