# Public hostname only, without https:// or a trailing slash.
DOMAIN=thought-hub.example.com

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-output-from-python-secrets-token-urlsafe
DJANGO_ALLOWED_HOSTS=thought-hub.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://thought-hub.example.com
FRONTEND_URL=https://thought-hub.example.com

POSTGRES_DB=thoughthub
POSTGRES_USER=thoughthub
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Start with a short HSTS lifetime. Increase it only after HTTPS is stable.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Console email is safe for the first boot but does not deliver messages.
# Replace these values with Brevo, Resend, or another SMTP provider to enable
# password-reset delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ThoughtHub <no-reply@example.com>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
